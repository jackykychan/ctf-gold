{
  "name": "ctf-gold",
  "version": "1.0.0",
  "private": true,
  "description": "Chow Tai Fook HK 9999 gold Buy/Sell price tracker dashboard",
  "type": "commonjs",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web,css \"tsx watch src/server.ts\" \"npm:dev:web\" \"npm:dev:css\"",
    "dev:web": "esbuild web/main.tsx --bundle --format=esm --sourcemap --outfile=public/app.js --tsconfig=tsconfig.web.json --jsx=automatic --define:process.env.NODE_ENV=\\\"development\\\" --watch",
    "dev:css": "tailwindcss -i web/index.css -o public/styles.css --watch",
    "dev:worker": "npm run build:web && npm run build:css && wrangler dev",
    "build": "npm run build:server && npm run build:web && npm run build:css",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "esbuild web/main.tsx --bundle --minify --format=esm --outfile=public/app.js --tsconfig=tsconfig.web.json --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:css": "tailwindcss -i web/index.css -o public/styles.css --minify",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "deploy": "npm run build:web && npm run build:css && wrangler deploy",
    "cf:db:create": "wrangler d1 create ctf-gold",
    "cf:migrate:local": "wrangler d1 migrations apply ctf-gold --local",
    "cf:migrate": "wrangler d1 migrations apply ctf-gold --remote"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "better-sqlite3": "^11.8.1",
    "chart.js": "^4.4.7",
    "chartjs-adapter-date-fns": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.13.3",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@tailwindcss/cli": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.7.3",
    "wrangler": "^4.125.0"
  }
}
