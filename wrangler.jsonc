{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctf-gold",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Static frontend (built into ./public). not_found_handling "none" lets the
  // Worker do its own SPA fallback to index.html for client-side routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // D1 database. Fill "database_id" after `npm run cf:db:create` (or the
  // `wrangler d1 create ctf-gold` it runs).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ctf-gold",
      "database_id": "95651b21-f8f2-4a83-8b24-7c56269b8fdb",
      "migrations_dir": "migrations"
    }
  ],

  // Poll the upstream API every 10 minutes (light + respectful; ~144 calls/day).
  "triggers": { "crons": ["*/10 * * * *"] },

  "vars": {
    "API_URL": "https://www.chowtaifook.com/bin/servlet/ctfweb/goldPrice?region=HK",
    "HEALTH_STALE_AFTER_MIN": "30",

    // Web Push (VAPID). Generate a keypair with `npm run gen:vapid`, then paste
    // the public key here and set the private key as a secret:
    //   wrangler secret put VAPID_PRIVATE_KEY
    // Empty VAPID_PUBLIC_KEY leaves push disabled (subscribe returns 503).
    "VAPID_PUBLIC_KEY": "BALr99IXb_O8H42GTbuSJLN1zVJ_815u4z3J-udDmSjhgY-FC34Dy4aFmWk8sKkgrezCsKe2voI7dnulR9Q42ig",
    "VAPID_CONTACT": "mailto:someunusualactivity@gmail.com"
  }
}
