# HTTP server port
PORT=3000

# SQLite database file path (point at a persistent volume when deployed)
DB_PATH=./data/gold.db

# Chow Tai Fook gold price API
API_URL=https://www.chowtaifook.com/bin/servlet/ctfweb/goldPrice?region=HK

# Adaptive polling (minutes)
START_POLL_INTERVAL_MIN=15
MIN_POLL_INTERVAL_MIN=5
MAX_POLL_INTERVAL_MIN=120
